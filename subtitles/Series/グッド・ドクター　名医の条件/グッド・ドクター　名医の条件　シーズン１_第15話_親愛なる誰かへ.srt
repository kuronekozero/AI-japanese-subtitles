483
00:23:17,980 --> 00:23:19,340
10

484
00:23:19,700 --> 00:23:21,060
9

485
00:23:21,720 --> 00:23:23,080
8

486
00:23:24,140 --> 00:23:25,500
8

487
00:23:26,740 --> 00:23:29,140
